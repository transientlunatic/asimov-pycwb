###### pycWB user_parameters.yaml — rendered by asimov ######
#
# This file is generated by the asimov-pycwb pipeline plugin for a single
# targeted/single-candidate cWB reconstruction (see this repository's
# README.md for why this is the supported mode, rather than cWB's
# continuous all-sky search).
#
# Only the run/segment/IFO/data fields below are actually templated from
# asimov's production metadata. Everything under "cWB production thresholds
# & regulators" is a fixed, untuned default copied from pycWB's example
# configurations - TODO: expose these via asimov blueprints once this
# plugin has been validated against a real run.

outputDir: "output"
nproc: {{ n_proc }}

analysis: "2G"
cfg_search: "r"

###### network configuration (templated) ######
ifo: [{% for ifo in ifos %}"{{ ifo }}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
refIFO: "{{ ref_ifo }}"

###### targeted follow-up window (templated) ######
# pycWB's job-segment module supports building a single job segment centred
# on a known trigger time (gps_center +/- time_left/time_right) instead of
# scanning a long stretch of data for triggers - this is the "case 2" mode
# in pycwb.modules.job_segment.job_segment, and is what makes a per-candidate
# asimov Production possible at all for a search-oriented pipeline like cWB.
gps_center: {{ event_time }}
time_left: {{ time_left }}
time_right: {{ time_right }}

###### frequency band (templated, falls back to cWB's own defaults) ######
fLow: {{ f_low }}
fHigh: {{ f_high }}

###### data (templated) ######
{%- if channels.size > 0 %}
channelNamesRaw: [{% for ifo in ifos %}"{{ ifo }}:{{ channels[ifo] }}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
{%- else %}
# TODO: no channel names were found in production.meta['data']['channels'];
# pycWB needs channelNamesRaw (or a `gwdatafind:` block, see pycWB's schema)
# to know which channel to read for each interferometer.
channelNamesRaw: []
{%- endif %}

{%- if data_files.size > 0 %}
# Frame-cache list files asimov has already prepared for this production
# (e.g. via asimov-gwdata), one per interferometer.
frFiles: [{% for ifo in ifos %}"{{ data_files[ifo] }}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
{%- else %}
# TODO: no data files were found in production.meta['data']['data files'];
# either arrange for asimov to fetch frames first, or add a `gwdatafind:`
# block here so pycWB can fetch frames itself (site/frametype/host).
frFiles: []
{%- endif %}

# TODO: data-quality/veto files (the `DQF` list) are not yet templated from
# asimov's production metadata - add per-IFO category veto files here if
# this analysis needs them (see pycWB's example user_parameters.yaml files
# for the expected `[ifo, path, category, ...]` row format).
DQF: []

wdmXTalk: "wdmXTalk/OverlapCatalog16-1024.bin"
healpix: 7

###### job submission (templated) ######
# batch_setup()/HTCondor read these directly from the config if they are not
# passed explicitly, so the plugin's build_dag() doesn't need to duplicate
# them as HTCondor(...) constructor arguments.
cluster: "condor"
accounting_group: "{{ accounting_group }}"
{%- if conda_env and conda_env != "" %}
conda_env: "{{ conda_env }}"
{%- endif %}
job_memory: "{{ job_memory }}"
job_disk: "{{ job_disk }}"

###### cWB production thresholds & regulators ######
# Fixed defaults, copied from pycWB's examples/GW190521_search example.
# TODO: these are not tuned for any particular search and are not yet
# exposed as templated/blueprint-configurable values.
segLen: 600
segMLS: 300
segTHR: 150
segEdge: 10

levelR: 3
l_low: 4
l_high: 10

bpp: 0.001
subnet: 0.5
subcut: -1.0
netRHO: 5.0
cedRHO: 5.0
netCC: 0.5
Acore: 1.7
Tgap: 0.2
Fgap: 128.0
delta: 0.5
cfg_gamma: -1.0
LOUD: 300
pattern: 10
iwindow: 100

###### output products ######
# Ask pycWB to produce the sky-localisation and waveform-reconstruction
# products this plugin's collect_assets() looks for.
save_cluster: True
save_sky_map: True
plot_sky_map: True
plot_trigger: True
save_waveform: True
plot_waveform: True
